# Copier ce fichier en .env puis adapter les valeurs.
NOM_APPLICATION=Sama Agri Voice
ENVIRONNEMENT=production
HOTE=127.0.0.1
PORT=8001

# Jeton Hugging Face : seulement pour télécharger les modèles
# (python -m scripts.telecharger_modeles). Pas utilisé ensuite.
HF_TOKEN=

# Modèles
APPAREIL=cpu
# Nombre de cœurs du serveur (0 = automatique)
NOMBRE_THREADS=4
# int8 sur CPU, float16 sur GPU
ASR_TYPE_CALCUL=int8
# 1 = rapide ; 5 = un peu plus précis mais plus lent
ASR_BEAM_SIZE=1
PRECHARGER_MODELES=true

# Outils
CHEMIN_FFMPEG=ffmpeg

# Limites
TAILLE_MAX_AUDIO_MO=10
DUREE_MAX_AUDIO_SECONDES=60
LONGUEUR_MAX_TEXTE=1000
DUREE_CONSERVATION_AUDIO_HEURES=24
